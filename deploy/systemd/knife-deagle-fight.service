# Knife Deagle Fight — systemd unit (example)
#
# Install:
#   sudo cp deploy/systemd/knife-deagle-fight.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now knife-deagle-fight
#
# The Node server serves client/dist itself (see server/src/index.js),
# so no separate static web server is needed behind this unit.

[Unit]
Description=Knife Deagle Fight — multiplayer knife + Deagle arena (Socket.IO)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=knife
Group=knife
WorkingDirectory=/opt/knife-deagle-fight

Environment=NODE_ENV=production
Environment=PORT=3001

ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/knife-deagle-fight
ProtectHome=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=knife-deagle-fight

[Install]
WantedBy=multi-user.target
